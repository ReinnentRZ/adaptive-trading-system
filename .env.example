# ==============================================================================
# ADAPTIVE TRADING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- BOT EXECUTION MODE ---
# Options: 'paper' (Mock Broker simulation) or 'live' (Real Binance execution)
BOT_MODE=paper

# --- ASSET & TIMEFRAME CONFIGURATION ---
# Active crypto trading pair (e.g. BTCUSDT, ETHUSDT, SOLUSDT)
ACTIVE_PAIR=BTCUSDT

# Kline timeframe interval (e.g. 5m, 15m, 30m, 1h)
ACTIVE_TIMEFRAME=5m

# --- CAPITAL & POSITION SIZING (SPOT MICRO ALLOCATION) ---
# Initial virtual capital in USDT for paper trading / telemetry
INITIAL_CAPITAL=100.0

# Capital allocated per trade in USDT (Fixed Notional Allocation)
TRADE_AMOUNT=5.0

# --- BINANCE API CREDENTIALS (Required for live trading / historical klines) ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# --- DYNAMIC ATR RISK MANAGEMENT ---
# Enable dynamic volatility-based Stop Loss & Take Profit
USE_ATR_RISK_MANAGEMENT=True
RISK_ATR_PERIOD=14
RISK_ATR_TP_MULTIPLIER=2.0
RISK_ATR_SL_MULTIPLIER=1.0

# --- SYSTEM & LOGGING SETTINGS ---
SYS_ENABLE_CONSOLE_LOG=True
SYS_LOG_FILE_PATH=logs/logs.txt
SYS_TELEMETRY_DB_PATH=logs/trading_telemetry.db
SYS_BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws